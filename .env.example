# Copy to .env and fill in. Real environment variables always win over this file.

# Required: an API key for the conversation model.
HEARTH_API_KEY=

# Provider defaults target DeepSeek. Any OpenAI-compatible endpoint works.
# HEARTH_PROVIDER=deepseek
# HEARTH_BASE_URL=https://api.deepseek.com
# HEARTH_MODEL=deepseek-v4-flash

# Which persona file to load.
# HEARTH_PERSONA=persona/example.yaml

# Where the database lives. One file is the whole person; back it up by copying it.
# HEARTH_DATA_DIR=data
# HEARTH_DB_PATH=data/hearth.db

# How many past turns are replayed as context. No summarisation yet, so this is
# a hard window.
# HEARTH_CONTEXT_TURNS=40

# HEARTH_TEMPERATURE=1.0
# HEARTH_USER_ID=local
